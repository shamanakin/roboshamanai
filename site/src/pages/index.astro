---
import Base from "../layouts/Base.astro";
import { decoder, site } from "../data/site";
import { graph } from "../lib/jsonld";
import { getFeatured, getNow, getProjects, getResearch, projectPath, researchPath } from "../lib/content";
import { kindLabel, stateLabel, tierLabel, authorshipLabel } from "../data/site";

const featured = await getFeatured();
const projects = await getProjects();
const research = (await getResearch()).slice(0, 3);
const now = (await getNow())[0];
const description = site.sub;
---

<Base
  title={`${site.name} — ${site.line}`}
  description={description}
  path="/"
  jsonLd={graph()}
>
  <main id="main" tabindex="-1">
    <header class="hero">
      <canvas id="field" aria-hidden="true"></canvas>
      <div class="scanline" aria-hidden="true"></div>
      <div class="hero-inner">
        <p class="mono eyebrow">// MATTHEW HEAKE · OPEN LAB · EST. {site.established}</p>
        <h1 class="reveal">An open lab at the<br />seam of <em>mind</em> &amp; <em>machine</em>.</h1>
        <p class="sub reveal">Things I build, research I run, and tools you can take.</p>
      </div>
      <p class="cue mono muted" aria-hidden="true">move to decode · scroll to enter</p>
    </header>
    <div id="lens" aria-hidden="true"></div>

    <div class="wrap">
      <section class="block" aria-labelledby="flag">
        <div class="sec-head">
          <h2 id="flag">Flagship</h2>
          <span class="mono muted">external · not embedded</span>
        </div>
        <div class="portal glass">
          <div>
            <span class="chip live">Live</span> <span class="chip subdomain">Subdomain</span>
            <h3>◇ DECODE<span>R</span></h3>
            <p class="muted lede">
              An AI research engine that decodes how things actually work: essays with confidence tiers, a connected principle graph, decoded news, and a separate version for agents.
            </p>
            <div class="stats mono">
              <span><b>{decoder.essays}</b> <span class="stat-label">essays</span></span>
              <span><b>{decoder.principles}</b> <span class="stat-label">principles</span></span>
            </div>
            <p class="mono muted">Counts fixed at build on {decoder.countsAsOf}. Not a live query.</p>
            <p>
              <a class="btn amber" href={decoder.url} rel="noopener noreferrer">Enter DECODER ↗ <span class="sr-only">(opens in a new tab)</span></a>
            </p>
          </div>
          <div class="graph-wrap">
            <svg class="graph" viewBox="0 0 400 280" role="img" aria-label="Decorative sketch of a network. Not a live export of DECODER's principle graph.">
              <g class="graph-drift" fill="none">
                <line x1="200" y1="140" x2="90" y2="70" stroke="rgba(168,85,247,.45)" />
                <line x1="200" y1="140" x2="310" y2="60" stroke="rgba(168,85,247,.45)" />
                <line x1="200" y1="140" x2="330" y2="170" stroke="rgba(168,85,247,.45)" />
                <line x1="200" y1="140" x2="250" y2="230" stroke="rgba(168,85,247,.45)" />
                <line x1="200" y1="140" x2="100" y2="210" stroke="rgba(168,85,247,.45)" />
                <line x1="90" y1="70" x2="150" y2="40" stroke="rgba(168,85,247,.3)" />
                <line x1="310" y1="60" x2="360" y2="110" stroke="rgba(168,85,247,.3)" />
                <line x1="100" y1="210" x2="60" y2="150" stroke="rgba(168,85,247,.3)" />
                <line x1="250" y1="230" x2="320" y2="240" stroke="rgba(168,85,247,.3)" />
                <circle cx="200" cy="140" r="5" fill="#FFB800" />
                <circle cx="90" cy="70" r="3.5" fill="#E8ECF4" />
                <circle cx="310" cy="60" r="5" fill="#FFB800" />
                <circle cx="330" cy="170" r="3.5" fill="#E8ECF4" />
                <circle cx="250" cy="230" r="3.5" fill="#E8ECF4" />
                <circle cx="100" cy="210" r="5" fill="#FFB800" />
                <circle cx="150" cy="40" r="3" fill="#E8ECF4" />
                <circle cx="360" cy="110" r="3" fill="#E8ECF4" />
                <circle cx="60" cy="150" r="3" fill="#E8ECF4" />
                <circle cx="320" cy="240" r="3" fill="#E8ECF4" />
                <circle cx="40" cy="90" r="2.5" fill="#E8ECF4" />
                <circle cx="370" cy="200" r="2.5" fill="#E8ECF4" />
              </g>
            </svg>
          </div>
        </div>
      </section>

      <section class="block" id="projects" aria-labelledby="ph">
        <div class="sec-head">
          <h2 id="ph">Projects</h2>
          <a class="mono" href="/projects/">all {projects.length} →</a>
        </div>
        <div class="grid">
          {featured.map((project) => (
            <a class="card glass-static rise" href={projectPath(project.id)} data-vt>
              <span>
                <span class={`chip ${project.data.state}`}>{stateLabel[project.data.state]}</span>
                {project.data.draft && <span class="chip draft">Draft</span>}
              </span>
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
              <div class="meta mono muted">
                <span>{project.data.meta ?? kindLabel[project.data.kind]}</span>
                <span>{project.data.year}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="block" id="research" aria-labelledby="rh">
        <div class="sec-head">
          <h2 id="rh">Research</h2>
          <a class="mono" href="/research/method/">method: Convergent Decoding v1.0</a>
        </div>
        {research.map((paper) => (
          <a class="paper" href={researchPath(paper.id)}>
            <span class="mono muted">{paper.data.idCode}<br />v{paper.data.version}</span>
            <span>
              <h3>{paper.data.title}</h3>
              <p>{paper.data.abstract}</p>
            </span>
            <span class="paper-tags">
              {paper.data.draft && <span class="chip draft">Draft</span>}
              <span class={`chip tier-${paper.data.tier}`}>{tierLabel[paper.data.tier]} · {authorshipLabel[paper.data.authorship]}</span>
            </span>
          </a>
        ))}
      </section>

      {now && (
        <section class="block" aria-labelledby="now-heading">
          <div class="sec-head">
            <h2 id="now-heading">Now</h2>
            <a class="mono" href="/now/">{now.data.date}</a>
          </div>
          <div class="now glass-static mono">
            {now.data.lines.map((line) => <span>▸ {line}</span>)}
          </div>
        </section>
      )}
    </div>
  </main>
  <script>
    import "../scripts/home.ts";
  </script>
</Base>
